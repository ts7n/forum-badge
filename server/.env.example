# Full Cookie: header from an authenticated FLOW browser session.
# Grab from Chrome DevTools → Network → any flow.snosites.com/api/v1/* request
# → Request Headers → "cookie" (include everything). One line, no newlines.
FLOW_COOKIE=""

# Bearer token the Mac client must present. Pick something long and random.
FORUM_BADGE_PASSWORD=""

# Optional. Defaults shown.
PORT=8787
REFRESH_INTERVAL_SECONDS=60
